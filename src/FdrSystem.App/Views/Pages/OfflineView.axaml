<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FdrSystem.App.Views.Pages.OfflineView">

  <Grid RowDefinitions="Auto,14,*">

    <!-- Barra de ações -->
    <Border Grid.Row="0" Classes="card" Padding="12,9">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Os botões passam para a linha seguinte em vez de saírem do cartão. -->
        <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="6"
                   VerticalAlignment="Center" Margin="0,0,10,0">
          <Button x:Name="ScanButton" Classes="primary" Click="Scan_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconRefresh}" Stroke="White" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
              <TextBlock Text="Ler iPhone" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="CopyButton" Classes="tool" Click="Copy_Click" Content="Copiar" />
          <Button x:Name="CopyAllButton" Classes="tool" Click="CopyAll_Click" Content="Copiar tudo" />
          <Button x:Name="ExportButton" Classes="tool" Click="Export_Click" Content="Exportar" />
          <Button x:Name="ShowAllButton" Classes="tool" Click="ShowAll_Click" Content="Ver todos" />
          <Button x:Name="DetailsButton" Classes="tool" Click="Details_Click" Content="Detalhes" />
          <Button x:Name="BatteryButton" Classes="tool" Click="Battery_Click" Content="Detalhes da bateria" />
        </WrapPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <CheckBox x:Name="RevealCheck" Content="Revelar IDs" IsChecked="False" Click="Reveal_Changed" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SoftBg}" CornerRadius="8" Padding="8,4"
                  BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
              <TextBox x:Name="SearchBox" Width="140" Background="Transparent" BorderThickness="0"
                       VerticalAlignment="Center" Watermark="filtrar campos" TextChanged="Search_Changed" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="340,16,*">

      <!-- Coluna esquerda: cartões -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="MODELO" Classes="label" FontWeight="Bold" />
              <TextBlock x:Name="ModelName" Text="—" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
              <TextBlock x:Name="ModelChip" Text="—" Classes="mono" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                  <TextBlock Text="RAM" Classes="label" />
                  <TextBlock x:Name="ModelRam" Text="—" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                  <TextBlock Text="Ecrã" Classes="label" />
                  <TextBlock x:Name="ModelScreen" Text="—" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,8,0,0">
                  <TextBlock Text="Câmara" Classes="label" />
                  <TextBlock x:Name="ModelCamera" Text="—" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,8,0,0">
                  <TextBlock Text="Ano" Classes="label" />
                  <TextBlock x:Name="ModelYear" Text="—" Classes="value" />
                </StackPanel>
              </Grid>
              <Separator Background="{DynamicResource CardBorder}" Margin="0,4" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="iOS" Classes="label" VerticalAlignment="Center" />
                <TextBlock x:Name="ModelIos" Text="—" Classes="value" />
              </StackPanel>
              <TextBlock x:Name="IosHint" Classes="label" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource IconBattery}" Stroke="{DynamicResource GreenText}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                <TextBlock Text="BATERIA" Classes="label" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="BatteryLevel" Text="—" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
              <ProgressBar x:Name="BatteryBar" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="{DynamicResource GreenText}" />
              <TextBlock x:Name="BatteryHealth" Text="Saúde —" Classes="value" />
              <TextBlock x:Name="BatteryCharging" Text="—" Classes="label" TextWrapping="Wrap" />
              <TextBlock x:Name="BatteryCycles" Text="Ciclos —" Classes="label" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="ARMAZENAMENTO" Classes="label" FontWeight="Bold" />
              <TextBlock x:Name="StorageText" Text="—" Classes="value" />
              <ProgressBar x:Name="StorageBar" Minimum="0" Maximum="100" Value="0" Height="8" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Tabela de campos -->
      <Border Grid.Column="2" Classes="card" Padding="6">
        <Grid RowDefinitions="*,Auto">
          <DataGrid x:Name="DetailsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" CanUserResizeColumns="True" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="120" />
              <DataGridTextColumn Header="Campo" Binding="{Binding Label}" Width="230" />
              <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="RowCountText" Grid.Row="1" Classes="label" Margin="8,6,0,2" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
